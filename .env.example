# Keep this file as a template only. Never commit real credentials.
SABRE_CLIENT_ID=
SABRE_CLIENT_SECRET=
# Certification is the safe default. Set the production host only after Sabre approval.
SABRE_BASE_URL=https://api.cert.platform.sabre.com
# Defaults to /v1/shop/flights. Set this only if Sabre provisions another search contract.
SABRE_SEARCH_PATH=
# Required before the booking endpoint can create a PNR. This must be provisioned for
# the agency PCC and map the standard booking payload to Sabre's Create PNR contract.
SABRE_BOOKING_PATH=
